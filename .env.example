# ====================================================================
# SMART CHILD Multi-School Platform - Environment Configuration
# ====================================================================

# Port for HTTP Server (Render sets this automatically)
PORT=3000

# Environment mode ('development' or 'production' or 'test')
NODE_ENV=production

# Database Configuration (Knex supports better-sqlite3 locally and pg in production)
# NOTE: Render's free disk is ephemeral, so production deployments must use PostgreSQL.
DB_CLIENT=better-sqlite3
DATABASE_URL=postgres://user:password@localhost:5432/maktab_watch

# JWT Secret & Expiry
JWT_SECRET=your-secure-random-jwt-secret-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Data Retention (Days to keep location points before automatic deletion)
RETENTION_DAYS=30

# Google Maps API Key (restricted by HTTP Referrer in Google Cloud Console)
GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------------------
# MAP TILE PROVIDER API KEYS (OPTIONAL)
# --------------------------------------------------------------------
MAP_API_KEY=
CARTO_API_KEY=
MAPBOX_ACCESS_TOKEN=
