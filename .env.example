# ====================================================================
# SMART CHILD Multi-School Platform - Environment Configuration
# ====================================================================

# Port for HTTP Server (Render sets this automatically)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=production

# --------------------------------------------------------------------
# MAP TILE PROVIDER API KEYS (OPTIONAL)
# --------------------------------------------------------------------
# DEFAULT FALLBACK: If NO key is provided, the platform automatically
# uses OpenStreetMap (OSM) standard tiles, which are 100% FREE, do NOT 
# require any API keys, and have NO "API KEY REQUIRED" watermarks!
#
# If you want to use custom CartoDB Basemaps or Mapbox, you can supply:
MAP_API_KEY=
CARTO_API_KEY=
MAPBOX_ACCESS_TOKEN=
